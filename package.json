{
  "name": "desktop-notes-app",
  "version": "1.0.1",
  "description": "Modern Desktop Notes Application with Smart Search",
  "author": "Aura Notes Team",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "tsc -b && vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.js --external:electron --external:sql.js && esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.js --external:electron && node -e \"require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist-electron/sql-wasm.wasm')\"",
    "dev:electron": "npm run build:electron && electron .",
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite --port 5173\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "build": "npm run build:vite && npm run build:electron",
    "preview": "vite preview",
    "test": "vitest run",
    "release": "node scripts/release.js",
    "release:win": "node scripts/release.js",
    "release:dir": "node scripts/release.js --dir",
    "release:portable": "node scripts/release.js --portable",
    "release:quick": "node scripts/release.js --skip-tests",
    "version:bump": "node scripts/bump-version.js patch",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.2"
  }
}
